# Copia este archivo a ".env.local" y rellena los valores del proyecto Supabase.
# (En Vercel, define estas mismas variables en Project Settings → Environment Variables.)
#
# Este proyecto comparte el mismo proyecto de Supabase que Protágoras — usa los
# mismos valores que en C:\Users\User\Desktop\Protagoras\.env.local. Las tablas
# de esta app usan el prefijo "ao_" para no chocar con las de Protágoras.
#
# Sin estas variables, la app funciona igualmente usando localStorage del navegador.
#
# Los encuentras en: Supabase → tu proyecto → Project Settings → API
#   - "Project URL"      -> NEXT_PUBLIC_SUPABASE_URL
#   - "anon public" key  -> NEXT_PUBLIC_SUPABASE_ANON_KEY

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...tu-clave-anon-publica
